class_name SoundPlayer
extends Node
## All of the game's sound: two looping ambience beds (wind, and a city hum
## that grows with the population) and a small pool of voices for one-shot
## effects. The .wav files are generated by tools/make_sounds.py.
##
## M mutes and unmutes everything.

const DIR := "res://audio/"
## One-shot effects that can sound at once; a new one replaces the oldest.
const VOICES := 6

## Ambience levels in decibels: the wind fades back a little as the city
## grows, while the city hum rises from near silence.
const WIND_DB_EMPTY := -12.0
const WIND_DB_FULL := -18.0
const CITY_DB_EMPTY := -45.0
const CITY_DB_FULL := -13.0
## Population at which the city hum reaches its full level.
const FULL_CITY_POPULATION := 400.0

var _wind: AudioStreamPlayer
var _city: AudioStreamPlayer
var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _streams: Dictionary[StringName, AudioStream] = {}


func _ready() -> void:
	_wind = _make_loop(&"wind_loop", WIND_DB_EMPTY)
	_city = _make_loop(&"city_loop", CITY_DB_EMPTY)
	for i in VOICES:
		var voice := AudioStreamPlayer.new()
		add_child(voice)
		_voices.append(voice)


func _unhandled_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key != null and key.pressed and not key.echo and key.physical_keycode == KEY_M:
		var master := AudioServer.get_bus_index(&"Master")
		AudioServer.set_bus_mute(master, not AudioServer.is_bus_mute(master))


## Play a one-shot effect by file name, without the extension.
## `pitch_spread` varies the pitch at random by up to that fraction either
## way, so repeated sounds do not all sound identical.
func play(sound: StringName, volume_db: float = 0.0, pitch_spread: float = 0.0) -> void:
	var stream := _stream(sound)
	if stream == null:
		return
	var voice := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	voice.stream = stream
	voice.volume_db = volume_db
	voice.pitch_scale = 1.0 + randf_range(-pitch_spread, pitch_spread)
	voice.play()


## Balance the ambience for a city of this many citizens.
func set_city_size(population: int) -> void:
	var fullness := sqrt(clampf(population / FULL_CITY_POPULATION, 0.0, 1.0))
	_wind.volume_db = lerpf(WIND_DB_EMPTY, WIND_DB_FULL, fullness)
	_city.volume_db = lerpf(CITY_DB_EMPTY, CITY_DB_FULL, fullness)


func _make_loop(sound: StringName, volume_db: float) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.volume_db = volume_db
	add_child(player)
	var stream := _stream(sound) as AudioStreamWAV
	if stream != null:
		# Loop the whole file, whatever the import settings say.
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = roundi(stream.get_length() * stream.mix_rate)
		player.stream = stream
		player.play()
	return player


## The stream for a sound, loaded once. Null (with one warning) if the file
## is missing or has not been imported by the editor yet.
func _stream(sound: StringName) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := "%s%s.wav" % [DIR, sound]
	var stream: AudioStream = null
	if ResourceLoader.exists(path):
		stream = load(path) as AudioStream
	if stream == null:
		push_warning("SoundPlayer: no sound at %s" % path)
	_streams[sound] = stream
	return stream
